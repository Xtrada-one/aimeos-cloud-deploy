APP_NAME=AimeosShop
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://IP_PUBLIK_EC2

SHOP_MULTILOCALE=false
SHOP_MULTISHOP=false
SHOP_REGISTRATION=false
SHOP_PERMISSION=admin
SHOP_MCP_AUTH=sanctum

LOG_CHANNEL=stderr
