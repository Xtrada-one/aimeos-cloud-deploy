DB_CONNECTION=mysql
DB_HOST=ENDPOINT_RDS_ANDA
DB_PORT=3306
DB_DATABASE=aimeos
DB_USERNAME=GANTI_USERNAME
DB_PASSWORD=GANTI_PASSWORD_KUAT

SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
